# ───────────────────────────────────────
# LAMMAR Perfumería — Variables de Entorno
# ───────────────────────────────────────
# En Vite, las variables deben empezar con VITE_
# para ser accesibles en el código del cliente.
#
# IMPORTANTE: Este archivo NO debe subirse a Git
# si contiene datos sensibles. Agrega .env a .gitignore.
# ───────────────────────────────────────

# Número de WhatsApp para recibir pedidos (con código de país)
VITE_WHATSAPP_NUMBER=573046420608

# Nombre de la tienda
VITE_STORE_NAME=LAMMAR Perfumería

# URL del sitio (para SEO y Open Graph)
VITE_SITE_URL=https://lamaarperfum.store

# Google Analytics 4 (crea tu ID en https://analytics.google.com y descomenta)
# VITE_GA4_ID=G-XXXXXXXXXX
