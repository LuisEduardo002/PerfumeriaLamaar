{
    "headers": [
        {
            "source": "/__markdown/(.*)",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/markdown; charset=utf-8"
                },
                {
                    "key": "Vary",
                    "value": "Accept, Accept-Encoding"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=300"
                }
            ]
        },
        {
            "source": "/.well-known/oauth-protected-resource",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/json"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        },
        {
            "source": "/openapi.json",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/json; charset=utf-8"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Vary",
                    "value": "Accept, Accept-Encoding"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/__markdown/:path*",
            "destination": "/__markdown/:path*"
        },
        {
            "source": "/catalogo",
            "destination": "/api/negotiate"
        },
        {
            "source": "/producto/:id",
            "destination": "/api/negotiate"
        },
        {
            "source": "/privacidad",
            "destination": "/api/negotiate"
        },
        {
            "source": "/privacy",
            "destination": "/api/negotiate"
        },
        {
            "source": "/about",
            "destination": "/api/negotiate"
        },
        {
            "source": "/nosotros",
            "destination": "/api/negotiate"
        },
        {
            "source": "/contact",
            "destination": "/api/negotiate"
        },
        {
            "source": "/contacto",
            "destination": "/api/negotiate"
        },
        {
            "source": "/terminos",
            "destination": "/api/negotiate"
        },
        {
            "source": "/index.html",
            "destination": "/api/negotiate"
        },
        {
            "source": "/",
            "destination": "/api/negotiate"
        },
        {
            "source": "/(.*)",
            "destination": "/api/negotiate"
        }
    ]
}